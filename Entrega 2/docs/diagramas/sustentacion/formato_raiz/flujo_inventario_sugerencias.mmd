    E -- Aprobar --> G["Marcar sugerencia como APROBADA"]
    G --> H["Administrador registra producto e inventario inicial (RF31)"]
    H --> I{"¿Precio mayor a 0 y cantidad no negativa?"}
    I -- No --> J["Rechazar registro por datos inválidos"]
    I -- Sí --> K["Producto incorporado en ubicación destino"]
    K --> L["Reabastecer o mover existencias entre ubicaciones (RF30, RF31)"]
    L --> M["Administrador consulta inventario consolidado (RF29)"]
